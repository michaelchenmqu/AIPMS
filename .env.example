# Postgres connection string. Neon (neon.tech) has a generous free tier and
# is the fastest way to get one — create a project, copy the connection
# string it gives you. Any Postgres works; nothing here is Neon-specific.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional — enables real AI calls. Without it, AI features run on a
# deterministic mock.
ANTHROPIC_API_KEY=

# Optional — the public base URL of this deployment (e.g.
# https://staging.aipms.up.railway.app, no trailing slash). Meta's Graph API
# needs a real, publicly-reachable image URL to post a property photo, so
# Facebook/Instagram posting only works once this is set to a live domain —
# never localhost.
SITE_URL=

# Optional — enables real channel-manager sync via Channex.io (property
# registration + booking webhooks). Without it, properties stay
# manually-managed and the webhook route 404s. See src/lib/channex.ts.
CHANNEX_API_KEY=
# Optional — verifies inbound webhook requests actually came from Channex.
# Set the same value in the Channex dashboard's webhook config once you
# confirm their signing header name against docs.channex.io.
CHANNEX_WEBHOOK_SECRET=

# Optional — enables real posting to a Facebook Page / Instagram Business
# account via the Meta Graph API. Without META_PAGE_ACCESS_TOKEN, campaigns
# fall back to simulated results. See src/lib/meta.ts.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Optional — enables real campaign emails via Resend (resend.com has a free
# tier). Without RESEND_API_KEY, emails are logged instead of sent. See
# src/lib/email.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL="AIPMS <onboarding@resend.dev>"

# Optional — enables WhatsApp guest inquiries in the staff Inbox (same Meta
# app as META_PAGE_ACCESS_TOKEN above, WhatsApp Business Platform product).
# Without these, the webhook route 404s and no reply box appears. See
# src/lib/whatsapp.ts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — paste the same value into the Meta App dashboard's
# WhatsApp webhook config (Verify Token field).
WHATSAPP_VERIFY_TOKEN=
